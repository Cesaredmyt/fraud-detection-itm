# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=cambiar_esta_password

# === SQLAlchemy DSN (se construye automáticamente, pero puede ser override) ===
# DATABASE_URL=postgresql+psycopg2://fraud_user:password@localhost:5432/fraud_detection

# === Paths del proyecto ===
DATA_RAW_PATH=./data/raw
DATA_INTERIM_PATH=./data/interim
DATA_PROCESSED_PATH=./data/processed
MODELS_PATH=./models
REPORTS_PATH=./reports

# === Configuración de experimentos ===
RANDOM_SEED=42
LOG_LEVEL=INFO

# === Entorno de ejecución ===
ENVIRONMENT=development